<resources>
    <!-- The Compose Material 3 UI supplies the in-app theme, and MainActivity
         goes edge to edge, so the system bars are left transparent rather than
         painted a colour that would fight the Compose background in one of the
         two light modes. -->
    <style name="Theme.Alfajr" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">?android:attr/colorBackground</item>
    </style>

    <!-- Keep the launch surface up until DataStore has selected the real first
         route. Without it, the default state briefly renders onboarding for an
         already configured alarm. -->
    <style name="Theme.Alfajr.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ringing_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Alfajr</item>
    </style>

    <!-- The ringing screen is deliberately near-black in every system theme and
         must not flash a light background before Compose draws. -->
    <style name="Theme.Alfajr.Ringing" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ringing_background</item>
        <item name="android:statusBarColor">@color/ringing_background</item>
        <item name="android:navigationBarColor">@color/ringing_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>
</resources>
