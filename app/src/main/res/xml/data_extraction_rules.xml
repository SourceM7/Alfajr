<?xml version="1.0" encoding="utf-8"?>
<!-- Match legacy backup behavior for Android 12+ cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/alarm_state.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/alarm_state.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
