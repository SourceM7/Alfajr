<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The whole application is an alarm clock, so USE_EXACT_ALARM applies.
         Android 12 and 12L predate it and still gate exact alarms behind
         SCHEDULE_EXACT_ALARM, which is why it is declared up to API 32. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Lets the ringing wake lock light the screen when a device's SystemUI
         does not launch the full-screen alarm. Android is moving
         ACQUIRE_CAUSES_WAKEUP behind this permission. -->
    <uses-permission android:name="android.permission.TURN_SCREEN_ON" />
    <!-- Android blocks an activity started from the background unless the
         application may draw over other apps. No overlay window is ever drawn;
         the permission is held only so the ringing screen can open over
         whatever is in use when the alarm goes off. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- WorkManager, which Glance runs widget sessions on, asks for network
         state for job constraints this app never sets. The app is offline. -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <application
        android:name=".app.AlfajrApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Alfajr">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Alfajr.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The full-screen alarm. Android starts it from the ringing
             notification's full-screen intent, and the ringing runtime starts
             it directly for the case Android downgrades that intent to a
             heads-up notification. Nothing outside the app may launch it. -->
        <activity
            android:name=".ui.AlarmRingingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity=".ringing"
            android:theme="@style/Theme.Alfajr.Ringing"
            android:turnScreenOn="true"
            tools:targetApi="o_mr1" />

        <!-- Owns playback, vibration, the wake lock, and the ringing
             notification for as long as an alarm is ringing. -->
        <service
            android:name=".alarm.AlarmRingingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Daily, snooze, and test alarms. Only this application can send
             these explicit intents. -->
        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false" />

        <!-- Android drops scheduled alarms across these system events. -->
        <receiver
            android:name=".alarm.SystemEventReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Home-screen and lock-screen widgets. Display only: none of them
             can change the alarm, and each opens the app when tapped. -->
        <receiver
            android:name=".widget.DawnSkyWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_sky_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_sky" />
        </receiver>
        <receiver
            android:name=".widget.FajrPillWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_pill_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_pill" />
        </receiver>
        <receiver
            android:name=".widget.FajrRingWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_ring_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_ring" />
        </receiver>
        <receiver
            android:name=".widget.FajrLockWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_lock_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_lock" />
        </receiver>

        <!-- Clock-driven widget redraws. Only this application can send them. -->
        <receiver
            android:name=".widget.WidgetTickReceiver"
            android:exported="false" />
    </application>

</manifest>
